{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIModelCatalog",
  "type": "object",
  "required": ["providers"],
  "properties": {
    "providers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "label", "models"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "models": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["id", "label", "reasoning"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "reasoning": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"}}
              }
            }
          }
        }
      }
    }
  },
  "examples": [{"providers": [{"id": "Codex", "label": "Codex", "models": [{"id": "example-model", "label": "Example model", "reasoning": ["default", "low", "medium", "high"]}]}]}]
}
